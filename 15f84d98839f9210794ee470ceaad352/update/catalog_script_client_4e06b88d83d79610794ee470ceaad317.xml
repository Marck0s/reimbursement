        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }

	var currentDate = new Date();
    var pickUpDate = new Date(newValue);

    var choseDate = currentDate.toISOString().split('T')[0];
    var selectedDateOnly = pickUpDate.toISOString().split('T')[0];
 
    if (selectedDateOnly > choseDate) {
        g_form.addErrorMessage("Sorry, but it's not allowed to select a date in the future!");
        g_form.setValue('expensedate', '');
        return false;
    }
    g_form.clearMessages();
}]]></script>
