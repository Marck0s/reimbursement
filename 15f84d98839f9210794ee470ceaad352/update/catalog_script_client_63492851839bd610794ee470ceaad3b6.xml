        <name>Avoiding Letters in Value Field</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function isNumeric(value) {
    var regex = /^[0-9]+(\.[0-9]*)?$/;
    return regex.test(value);
}

function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || newValue === '') {
        return;
    }

    var valueBRL = g_form.getValue('valuebrl');

    g_form.clearMessages();

    if (!isNumeric(valueBRL)) {
        g_form.addErrorMessage('Please enter a numeric value only!');
        g_form.setValue('valuebrl', '');
    }
}
]]></script>
